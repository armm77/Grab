{
	"ApplicationDescription" = "Screen capture application for NextSpace.";
	ApplicationIcon = "Grab.App.tiff";
	ApplicationName = Grab;
	ApplicationRelease = "0.9.1";
	Authors = (
		"Andres Morales",
	);
	Copyright = "Copyright (C) 2024";
	CopyrightDescription = GPL;
	FullVersionID = "0.9.1";
	NSExecutable = Grab;
	NSIcon = "Grab.App.tiff";
	NSMainNibFile = "Grab.gorm";
	NSPrincipalClass = NSApplication;
	NSRole = Application;
	URL = "https://github.com/armm77";

	// ── Services provided by Grab to other applications ──────────────────────
	// Each service runs the full capture flow (animation + panel) and puts
	// the resulting image on the pasteboard so the requesting app can use it.
	// NSPortName must match the port name registered in -applicationDidFinishLaunching.
	// NSMessage is the selector called on the services provider object (GrabController).
	NSServices = (
		{
			// Grab › Screen — captures the full screen
			NSMenuItem = {
				default = "Grab/Screen";
			};
			NSMessage = "grabScreen";
			NSPortName = "Grab";
			NSReturnTypes = (
				"NSTIFFPboardType"
			);
			NSTimeout = "30000";
		},
		{
			// Grab › Selection — user drags a rubber-band rectangle
			NSMenuItem = {
				default = "Grab/Selection";
			};
			NSMessage = "grabSelection";
			NSPortName = "Grab";
			NSReturnTypes = (
				"NSTIFFPboardType"
			);
			NSTimeout = "60000";
		},
		{
			// Grab › Window — user clicks a window to capture it
			NSMenuItem = {
				default = "Grab/Window";
			};
			NSMessage = "grabWindow";
			NSPortName = "Grab";
			NSReturnTypes = (
				"NSTIFFPboardType"
			);
			NSTimeout = "60000";
		}
	);
}
