{
    "## Comment" = "Do NOT change this file, Gorm maintains it";
    AppController = {
	Actions = (
	    "showInfoPanel:",
	    "showCursorPanel:",
	    "showInspectorPanel:",
	    "captureScreen:"
	);
	Outlets = (
	    infoPanel,
	    inspectorPanel,
	    cursorPanel
	);
	Super = NSObject;
    };
    FirstResponder = {
	Actions = (
	    "appIconFullScreen:",
	    "appIconTimeScreen:",
	    "appIconWindow:",
	    "captureFullScreen:",
	    "captureScreen:",
	    "captureScreenSection:",
	    "captureTimedScreen:",
	    "captureWindow:",
	    "changeCursor:",
	    "copyImageToPasteboard:",
	    "printImage:",
	    "saveImage:",
	    "showCursorPanel:",
	    "showHelpPanel:",
	    "showInfoPanel:",
	    "showInspectorPanel:",
	    "showPrefPanel:",
	    "showPrefsPanel:",
	    "startTimer:",
	    "toggleAudio:"
	);
	Super = NSObject;
    };
    GrabController = {
	Actions = (
	    "toggleAudio:",
	    "printImage:",
	    "copyImageToPasteboard:",
	    "saveImage:",
	    "changeCursor:",
	    "startTimer:",
	    "appIconWindow:",
	    "appIconFullScreen:",
	    "appIconTimeScreen:",
	    "captureScreenSection:",
	    "showHelpPanel:",
	    "showInfoPanel:",
	    "showCursorPanel:",
	    "showInspectorPanel:"
	);
	Outlets = (
	    audioMenuItem,
	    widthField,
	    heightField,
	    depthField,
	    sizeField,
	    alphaCheckbox
	);
	Super = NSObject;
    };
}