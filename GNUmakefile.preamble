#
# GNUmakefile.preamble — Grab Application
#
# Compiler and linker flags for ARC + GNUstep/NextSpace/libobjc2.
# Included automatically by GNUmakefile before application.make.
#

# ── ARC flags ─────────────────────────────────────────────────────────────────
# -fobjc-arc            Enable Automatic Reference Counting.
# -fobjc-arc-exceptions Ensure ARC clean-up runs correctly through ObjC
#                       exceptions (required by GNUstep exception model).
# -fblocks              Enable clang Blocks extension, required by
#                       dispatch_async(queue, ^{ ... }).
ADDITIONAL_OBJCFLAGS += \
	-fobjc-arc \
	-fobjc-arc-exceptions \
	-fblocks

# ── Runtime: libobjc2 ─────────────────────────────────────────────────────────
# Force use of the libobjc2 runtime instead of the legacy GNU runtime.
# Required for ARC, blocks, and dispatch support on GNUstep/NextSpace.
ADDITIONAL_OBJCFLAGS += -fobjc-runtime=gnustep-2.0

# ── Include paths ─────────────────────────────────────────────────────────────
ADDITIONAL_INCLUDE_DIRS += \
	-IControllers \
	-IManagers \
	-ICapture \
	-IViews

# ── Linker flags ──────────────────────────────────────────────────────────────
# -lDesktopKit  NextSpace DesktopKit (NXTSavePanel, NXTAlert, etc.)
# -lSystemKit   NextSpace SystemKit
# -lobjc        libobjc2 runtime (provides ARC retain/release stubs).
# -ldispatch    libdispatch (GCD) — dispatch_once, dispatch_async, main queue.
# -lX11         X11 base library (display, windows, events).
# -lXcomposite  XComposite extension (off-screen window pixmap capture).
# -lXcursor     Xcursor library (ARGB cursor from TIFF bitmap).
ADDITIONAL_LDFLAGS += \
	-lDesktopKit \
	-lSystemKit \
	-lobjc \
	-ldispatch \
	-lX11 \
	-lXcomposite \
	-lXcursor
