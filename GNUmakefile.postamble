#
# GNUmakefile.postamble — Grab Application
#

# After the app bundle is assembled, ensure Info-gnustep.plist has the
# correct NSMainNibFile entry. gnustep-make 2.9.x may leave it empty
# even when Grab_MAIN_MODEL_FILE is set, depending on the version.
after-all::
	@PLIST="$(GNUSTEP_BUILD_DIR)/$(APP_NAME).app/Resources/Info-gnustep.plist"; \
	if [ -f "$$PLIST" ]; then \
	    if grep -q 'NSMainNibFile = ""' "$$PLIST" 2>/dev/null; then \
	        echo "  Patching NSMainNibFile in Info-gnustep.plist..."; \
	        sed -i 's/NSMainNibFile = "";/NSMainNibFile = "Grab.gorm";/' "$$PLIST"; \
	    fi; \
	    if grep -q 'NSPrincipalClass = ""' "$$PLIST" 2>/dev/null; then \
	        sed -i 's/NSPrincipalClass = "";/NSPrincipalClass = "NSApplication";/' "$$PLIST"; \
	    fi; \
	fi
	@echo "  Registering Grab services with the system..."; \
	if which make_services > /dev/null 2>&1; then \
	    make_services || echo "  Warning: make_services failed (services may not appear until next login)"; \
	else \
	    echo "  Warning: make_services not found — run 'make_services' manually after install"; \
	fi

after-install::
	$(MKDIRS) $(GNUSTEP_LOCAL_APPS)/Grab.app/Resources
